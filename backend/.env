# Environment Variables untuk VidSnap Backend
# Salin file ini menjadi .env dan isi nilainya

# Port server (default: 8000)
PORT=8000

# Environment (development / production)
ENV=development

# Izinkan CORS dari domain ini (pisahkan dengan koma jika lebih dari satu)
# Contoh: https://vidsnap.vercel.app,https://www.vidsnap.my.id
ALLOWED_ORIGINS=*

# WAJIB DIISI di hosting cloud (Railway/Render) agar YouTube tidak menampilkan
# error "Sign in to confirm you're not a bot" / "Video memerlukan login".
# Isi dengan seluruh ISI file cookies.txt (format Netscape) hasil export dari
# akun YouTube yang sudah login. Cara mendapatkannya & alasannya ada di README,
# bagian "Mengatasi error verifikasi login/bot".
YOUTUBE_COOKIES=

